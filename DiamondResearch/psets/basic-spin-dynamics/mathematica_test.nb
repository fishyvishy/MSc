8928cff3ea9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Spin", "-", 
    RowBox[{"1", " ", "Matrices", " ", "in", " ", "natural", " ", "units", " ", 
     RowBox[{"(", 
      RowBox[{"hbar", " ", "=", " ", "1"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Sx", "=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Sy", "=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "I"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"I", ",", "0", ",", 
          RowBox[{"-", "I"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "I", ",", "0"}], "}"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sz", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Delta", "=", "2.87"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Zero", " ", "Field", " ", "Splitting", " ", "in", " ", "GHz"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamma", " ", "=", " ", 
     RowBox[{"-", "0.0028"}]}], " ", 
    RowBox[{"(*", " ", 
     RowBox[{"gyromagnetic", " ", "ratio", " ", "in", " ", 
      RowBox[{"GHz", "/", "G"}]}], " ", "*)"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bmin", " ", "=", " ", "0"}], " ", 
    RowBox[{"(*", 
     RowBox[{"minimum", " ", "B", " ", "field", " ", "in", " ", "Gauss"}], 
     "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bmax", " ", "=", " ", "1050"}], " ", 
    RowBox[{"(*", 
     RowBox[{"maximum", " ", "B", " ", "field", " ", "in", " ", "Gauss"}], 
     " ", "*)"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.997218120488854*^9, 3.9972181755949373`*^9}, {
