Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dsolved", " ", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"a", "'"}], "[", "t", "]"}], " ", "==", " ", 
         RowBox[{
          RowBox[{"I", " ", 
           RowBox[{"\[Delta]", "/", "2"}], " ", 
           RowBox[{"a", "[", "t", "]"}]}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"\[CapitalOmega]", " ", "/", " ", "2"}], " ", 
           RowBox[{"b", "[", "t", "]"}]}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"b", "'"}], "[", "t", "]"}], " ", "==", 
         RowBox[{
          RowBox[{
           RowBox[{"-", " ", "I"}], " ", 
           RowBox[{"\[Delta]", "/", "2"}], " ", 
           RowBox[{"b", "[", "t", "]"}]}], " ", "+", " ", 
          RowBox[{"I", " ", 
           RowBox[{"\[CapitalOmega]", " ", "/", " ", "2"}], " ", 
           RowBox[{"a", "[", "t", "]"}]}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"a", "[", "0", "]"}], " ", "==", " ", "1"}], ",", " ", 
        RowBox[{
         RowBox[{"b", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "[", "t", "]"}], ",", " ", 
        RowBox[{"b", "[", "t", "]"}]}], "}"}], ",", " ", "t"}], "]"}], " ", "//",
     " ", "FullSimplify"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.9972214135846863`*^9, 3.997221635008583*^9}, {
  3.99722170510185*^9, 3.997221724250383*^9}, {3.9972269994844303`*^9, 
  3.997227002944921*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"a2dd598a-d693-4eb5-85d3-b6aeb54272d9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", "t", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[Delta]", "2"], "+", 
          SuperscriptBox["\[CapitalOmega]", "2"]}]]}], "]"}], "+", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", "\[Delta]", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", "t", " ", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["\[Delta]", "2"], "+", 
            SuperscriptBox["\[CapitalOmega]", "2"]}]]}], "]"}]}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["\[Delta]", "2"], "+", 
         SuperscriptBox["\[CapitalOmega]", "2"]}]]]}]}], ",", 
    RowBox[{
     RowBox[{"b", "[", "t", "]"}], "\[Rule]", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[CapitalOmega]", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", "t", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["\[Delta]", "2"], "+", 
           SuperscriptBox["\[CapitalOmega]", "2"]}]]}], "]"}]}], 
      SqrtBox[
       RowBox[{
        SuperscriptBox["\[Delta]", "2"], "+", 
        SuperscriptBox["\[CapitalOmega]", "2"]}]]]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.997221507034676*^9, 3.997221526097516*^9}, {
   3.997221571238019*^9, 3.99722157888375*^9}, {3.997221620028059*^9, 
